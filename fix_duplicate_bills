MARK = b"Duplicate-bill detection"
SKIP = {"node_modules", ".git", "site-packages", "AppData", "__pycache__", "$Recycle.Bin", "Windows"}


def find_copies(root):
    for folder, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if d not in SKIP]
        if "bills.py" in files:
            path = os.path.join(folder, "bills.py")
            try:
                with open(path, "rb") as fh:
                    if MARK in fh.read():
                        yield path
            except OSError:
                pass


def main():
    target = sys.argv[1] if len(sys.argv) > 1 else os.path.expanduser("~")
    if os.path.isfile(os.path.join(target, "main.py")):          # the backend's app folder was given
        paths = [os.path.join(target, "bills.py")]
        if not os.path.exists(paths[0]):
            open(paths[0], "wb").close()
            paths = [paths[0]]
    else:
        print("Searching", target, "...")
        paths = list(find_copies(target))
    if not paths:
        print("No bills.py found. Run again with the backend's app folder, e.g.:")
        print('   python fix_duplicate_bills.py "C:\\Users\\GK\\Downloads\\expense_tracker_backend\\expense_tracker_backend\\app"')
        return
    new_text = NEW_BILLS_PY.replace(b"\r\n", b"\n")
    for p in paths:
        with open(p, "rb") as fh:
            old = fh.read()
        if old.replace(b"\r\n", b"\n") == new_text:
            print("already up to date :", p)
            continue
        if old:
            with open(p + ".bak", "wb") as fh:
                fh.write(old)
        with open(p, "wb") as fh:
            fh.write(new_text)
        print("UPDATED            :", p)

    print()
    s = socket.socket()
    s.settimeout(1)
    busy = s.connect_ex(("127.0.0.1", 8000)) == 0
    s.close()
    if busy:
        print("Something is running on port 8000 - that is the OLD backend. Close it, then start it again:")
        try:
            out = subprocess.run(["netstat", "-ano"], capture_output=True, text=True).stdout
            for line in out.splitlines():
                if ":8000" in line and "LISTENING" in line:
                    pid = line.split()[-1]
                    print("   found PID", pid, "->  taskkill /PID", pid, "/F")
        except OSError:
            pass
    else:
        print("Port 8000 is free - the backend is not running.")
    print("Then, in the backend's app folder:   python -m uvicorn main:app")
    print("The terminal must show:  [bills] duplicate bills are checked inside one expense only")


if __name__ == "__main__":
    main()